# Optional. Without API configuration, the UI starts in source-excerpt mode.
# Copy this file to .env, then enter your provider's values locally.
# The organizers inject their own URL, key and model during automated judging.
# No fixed generative model is selected by this project.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Alternative names accepted by the same client (leave unused aliases empty).
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEN_MODEL=

# In Docker, DATA_DIR is a container path, not a path on the host computer.
# Leave empty for /app/data in Compose, or the bundled data directory locally.
DATA_DIR=
PORT=8000

# V20 defaults; explicitly supplied settings take priority within code limits.
TEMPERATURE=0
MAX_TOKENS=8192
MAX_WORKERS=4
ANSWER_TIMEOUT_SECONDS=120
API_TIMEOUT_SECONDS=90
API_RETRIES=1
RUN_TIMEOUT_SECONDS=1100
ANSWER_VERIFY=1
QUERY_NORMALIZE=0

# Both API features are enabled when credentials/model settings are available.
# The portable BGE index still needs live query embeddings and space validation.
ENABLE_EMBEDDINGS=1
EMB_MODEL=baai/bge-m3
EMBEDDER_API_KEY=
ENABLE_RERANKER=1
# Set the exact reranker ID supplied by the provider; do not guess the ID.
RERANKER_MODEL=
RERANKER_API_KEY=
RERANKER_TOP_N=8
RERANK_CANDIDATES=32
RERANK_TIMEOUT_SECONDS=8
RETRIEVAL_TIMEOUT_SECONDS=15

# Optional writable cache path inside the container, e.g. /tmp/psb-vectors.
# Blank means no disk cache. The packaged index is read-only.
RETRIEVAL_CACHE_DIR=
# Optional YYYY-MM-DD clock anchor for interpreting relative dates.
REFERENCE_DATE=
DIAGNOSTIC_API_FAILURES=0

# The platform may supply TOP_K / CHUNKER; V20's custom implementation ignores them.
# TOP_K=
# CHUNKER=
